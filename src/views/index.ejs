<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/htmx.min.js" defer></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Ticketing</h1>
      <p class="mt-2 text-slate-600">Internal ticketing system — foundation build.</p>
      <dl class="mt-8 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <dt class="text-slate-500">Schema version</dt>
          <dd class="mt-1 font-mono text-lg"><%= schemaVersion %></dd>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <dt class="text-slate-500">Environment</dt>
          <dd class="mt-1 font-mono text-lg"><%= nodeEnv %></dd>
        </div>
      </dl>
    </main>
  </body>
</html>