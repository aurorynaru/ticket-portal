<%- include('partials/head') %>
<%- include('partials/nav') %>
<main id="main-content" class="mx-auto w-full max-w-[1400px] flex-1 px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-xl font-semibold tracking-tight">Notifications</h1>
    <form method="post" action="/notifications/read-all">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
      <button type="submit" class="rounded-md border border-line px-3.5 py-2 text-sm text-ink-soft hover:bg-line-soft hover:text-ink">Mark all as read</button>
    </form>
  </div>

  <div class="mt-6 overflow-hidden rounded-lg border border-line bg-surface">
    <% if (rows.length === 0) { %>
      <p class="px-4 py-12 text-center text-sm text-ink-faint">No notifications yet.</p>
    <% } %>
    <ul class="divide-y divide-line-soft">
      <% rows.forEach(function (n) { %>
        <li class="flex items-start justify-between gap-3 px-4 py-3 <%= n.read_at ? 'opacity-60' : '' %>">
          <div class="min-w-0 text-sm">
            <% if (n.redacted) { %>
              <p class="text-ink-soft">A ticket you no longer have access to was updated.</p>
            <% } else { %>
              <p class="text-ink-soft">
                <span class="font-medium text-ink"><%= n.actorName %></span>
                <span> <%= n.label %></span>
                <% if (n.ticket_no !== null) { %>
                  <a href="/tickets/<%= n.ticket_id %>" class="font-medium text-accent hover:underline">TKT-<%= String(n.ticket_no).padStart(6, '0') %></a>
                  <span> · </span><span><%= n.ticket_title %></span>
                <% } %>
              </p>
            <% } %>
            <p class="mt-0.5 text-xs text-ink-faint"><%= fmtTime(n.created_at) %></p>
          </div>
          <% if (!n.read_at) { %>
            <form method="post" action="/notifications/<%= n.id %>/read" class="shrink-0">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-md border border-line px-2.5 py-1 text-xs text-ink-soft hover:bg-line-soft">Mark read</button>
            </form>
          <% } else { %>
            <span class="shrink-0 text-xs text-ink-faint">Read</span>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </div>
</main>
<%- include('partials/foot') %>