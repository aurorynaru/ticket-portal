<%- include('partials/head') %>
<%- include('partials/nav') %>
<main id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 sm:px-6">
  <h1 class="text-xl font-semibold tracking-tight">Account</h1>
  <dl class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Name</dt>
      <dd class="mt-1"><%= user.name %></dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Email</dt>
      <dd class="mt-1"><%= user.email %></dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Role</dt>
      <dd class="mt-1"><%= user.role %></dd>
    </div>
  </dl>
</main>
<%- include('partials/foot') %>