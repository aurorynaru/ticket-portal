<%- include('partials/head') %>
<%- include('partials/nav') %>
<main id="main-content" class="mx-auto w-full max-w-[1400px] flex-1 px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold tracking-tight">Welcome, <%= user.name %></h1>
      <p class="mt-1 text-sm text-ink-soft">Dashboard · role: <%= user.role %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/dashboard/export.csv" class="rounded-md border border-line px-3.5 py-2 text-sm text-ink-soft hover:bg-line-soft hover:text-ink">Export CSV</a>
      <% if (user.role !== 'viewer') { %>
        <a href="/tickets/new" class="rounded-md bg-ink px-3.5 py-2 text-sm font-medium text-white hover:bg-zinc-800">New ticket</a>
      <% } %>
    </div>
  </div>

  <dl class="mt-8 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3 lg:grid-cols-6">
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Assigned to me</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums"><%= stats.assignedOpen %></dd>
      <dd class="text-xs text-ink-faint">open</dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Created by me</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums"><%= stats.createdOpen %></dd>
      <dd class="text-xs text-ink-faint">open</dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Open</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums"><%= stats.openTotal %></dd>
      <dd class="text-xs text-ink-faint">visible to you</dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Overdue</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums <%= stats.overdue > 0 ? 'text-red-700' : '' %>"><%= stats.overdue %></dd>
      <dd class="text-xs text-ink-faint">past due date</dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Resolved</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums"><%= stats.resolved %></dd>
      <dd class="text-xs text-ink-faint">awaiting close</dd>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">Closed</dt>
      <dd class="mt-1 font-mono text-2xl tabular-nums"><%= stats.closed %></dd>
      <dd class="text-xs text-ink-faint">completed</dd>
    </div>
  </dl>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="rounded-lg border border-line bg-surface p-4 lg:col-span-2">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-soft">Recent activity</h2>
      <% if (activity.length === 0) { %>
        <p class="mt-3 text-sm text-ink-faint">No ticket activity visible to you yet.</p>
      <% } else { %>
        <ul class="mt-3 divide-y divide-line-soft">
          <% activity.forEach(function (item) { %>
            <li class="flex items-baseline justify-between gap-3 py-2 text-sm">
              <span class="min-w-0">
                <span class="text-ink-soft"><%= item.actor_name || 'Someone' %></span>
                <span class="text-ink-soft"> <%= item.label %></span>
                <a href="/tickets/<%= item.ticket_id %>" class="font-medium text-accent hover:underline">TKT-<%= String(item.ticket_no).padStart(6, '0') %></a>
                <span class="text-ink-soft"> · <%= item.title %></span>
              </span>
              <time class="shrink-0 text-xs text-ink-faint"><%= fmtTime(item.created_at) %></time>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-soft">Quick links</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a href="/tickets" class="text-accent hover:underline">Browse all tickets</a></li>
        <li><a href="/tickets?scope=assigned" class="text-accent hover:underline">Assigned to me</a></li>
        <li><a href="/tickets?scope=created" class="text-accent hover:underline">Created by me</a></li>
        <li><a href="/search" class="text-accent hover:underline">Search tickets</a></li>
        <li><a href="/notifications" class="text-accent hover:underline">Notifications</a></li>
      </ul>
    </div>
  </div>
</main>
<%- include('partials/foot') %>