# Copy for local development only; never commit a real secret.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./.local/tickets.db
UPLOAD_DIR=./.local/uploads
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_32_PLUS_BYTES
SESSION_TRUSTED_ORIGIN=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Manila
MAX_UPLOAD_BYTES=10485760
NOTIFICATION_POLL_SECONDS=45
